# Environment Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="Campus Sensor Monitoring & Alert Engine"
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration (Asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_sensors
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campus_sensors
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=50
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# JWT & Security
JWT_SECRET=f3b89083161c56ab4d8c7c936081498b584a29a4eb14bca8892dcf3519c67dc9
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sensor Ingestion & Alert Engine Tuning
MAX_BATCH_SIZE=10000
DEFAULT_ALERT_COOLDOWN_SECONDS=300
SLIDING_WINDOW_MAX_RETENTION_SECONDS=3600
RULE_CACHE_TTL_SECONDS=60
